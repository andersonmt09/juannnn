# Copia este archivo como .env y completa los valores.
# El archivo .env no se sube al repositorio.

# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500

# Base de datos MySQL (externa)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=axon_db
DB_SSL=false

# JWT (mínimo 16 caracteres cada uno)
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Correo SMTP (si se deja vacío, los códigos se muestran en la consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AXON <no-reply@axon.local>
