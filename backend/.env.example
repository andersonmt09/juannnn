# ============================================================
#  AXON Stack Flow - Variables de entorno del backend
#  Copia este archivo como .env y completa los valores.
#  El archivo .env NUNCA se sube al repositorio.
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Origen(es) del frontend permitidos por CORS (separados por coma)
FRONTEND_ORIGIN=http://localhost:5500

# --- Base de datos EXTERNA (MySQL 8) ---
# La base de datos no está dentro del proyecto. Pide estos datos
# al administrador del servidor de base de datos.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=axon_db
# true si el proveedor exige conexión cifrada (TLS)
DB_SSL=false

# --- JWT (mínimo 16 caracteres cada uno) ---
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# --- Correo SMTP (vacío = modo desarrollo: el código se imprime en consola) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AXON <no-reply@axon.local>
