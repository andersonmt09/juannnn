# Copia este archivo como .env y completa los valores.
# El archivo .env no se sube al repositorio.

# Servidor (sirve la API en /api y el frontend en /)
PORT=4000
NODE_ENV=development

# API de la base de datos externa
# El proyecto no se conecta directamente a la base: usa su API.
DATABASE_API_URL=
DATABASE_API_KEY=
DATABASE_API_TIMEOUT_MS=5000

# JWT (mínimo 16 caracteres cada uno)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Correo SMTP (si se deja vacío, los códigos se muestran en la consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AXON <no-reply@axon.local>
