# === Servidor ===
PORT=4000
NODE_ENV=development

# === Base de datos MySQL ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=axon_db

# === JWT ===
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
