{
  "name": "axon-stack-flow",
  "version": "2.0.0",
  "description": "Gestión de usuarios con inicio de sesión en dos pasos y monitoreo de API",
  "private": true,
  "main": "servidor/codigo/arranque.js",
  "scripts": {
    "servidor": "node servidor/codigo/arranque.js",
    "servidor:dev": "node --watch servidor/codigo/arranque.js",
    "cliente": "node cliente/automatizacion/servidor-local.js",
    "inicializar-bd": "node servidor/automatizacion/inicializar-bd.js",
    "crear-admin": "node servidor/automatizacion/crear-admin.js",
    "pruebas": "node --test servidor/pruebas/unitarias/validadores.test.js servidor/pruebas/unitarias/utilidades.test.js",
    "pruebas:integracion": "node --test servidor/pruebas/integracion/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nodemailer": "^6.9.15"
  }
}
